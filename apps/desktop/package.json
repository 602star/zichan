{
  "name": "@zichan/desktop",
  "version": "0.5.1",
  "private": true,
  "description": "Tauri 2 desktop shell wrapping the @zichan/web build",
  "scripts": {
    "prepare:build": "node scripts/before-build.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "android:init": "tauri android init && node scripts/configure-android.mjs",
    "android:configure": "node scripts/configure-android.mjs",
    "android:dev": "node scripts/configure-android.mjs && tauri android dev",
    "android:build": "node scripts/configure-android.mjs && tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "icon": "tauri icon src-tauri/icons/icon.png",
    "server": "npm run server:build && npm run server:run",
    "server:build": "npm run build:server --prefix ../..",
    "server:run": "node scripts/server.mjs",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "release:check": "npm run server:build && npm run prepare:resources && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "esbuild": "^0.28.2"
  }
}
