{
  "name": "@zichan/sync-server",
  "version": "0.5.5",
  "private": true,
  "description": "End-to-end-encrypted commit-replica server with accounts and administration",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "npm run build:dependencies && npm run build:app",
    "build:dependencies": "npm run build --workspace @zichan/logger --workspace @zichan/core --workspace @zichan/db",
    "start": "npm run build && node dist/server.mjs",
    "maintenance": "npm run build:dependencies && tsc -p tsconfig.json && node dist/maintenance.js",
    "backup": "npm run maintenance -- backup",
    "verify-backup": "npm run maintenance -- verify-backup",
    "restore": "npm run maintenance -- restore",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:app": "tsc -p tsconfig.json && node scripts/build-server.mjs",
    "start:built": "node dist/server.mjs",
    "prune-backups": "npm run maintenance -- prune-backups",
    "retire-node": "npm run maintenance -- retire-node",
    "retire-local-replica": "npm run maintenance -- retire-local-replica"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@zichan/core": "*",
    "@zichan/db": "*",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@serenity-kit/opaque": "^1.1.0",
    "systeminformation": "^5.33.19"
  }
}
