# Linux test deployment. Build from the repository root.
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS build
WORKDIR /repo
COPY . .
RUN npm ci
RUN npm run build:server

FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
WORKDIR /app
COPY --from=build /repo/apps/sync-server/dist /app/bootstrap/release/dist
COPY --from=build /repo/apps/web/dist /app/bootstrap/release/web-dist
COPY --from=build /repo/apps/sync-server/package.json /app/bootstrap/release/package.json
COPY apps/sync-server/scripts/update-launcher.mjs /app/bootstrap/update-launcher.mjs
ENV HOST=127.0.0.1 PORT=8787 DATA_DIR=/state/server WEB_DIST=/app/runtime/current/web-dist ZICHAN_UPDATE_RUNTIME_DIR=/app/runtime ENABLE_WEB=1 ENABLE_SYNC=1 REGISTRATION_MODE=invite BASE_PATH= TRUSTED_PROXIES=127.0.0.1 ALLOW_INSECURE_HTTP=0
RUN mkdir -p /app/runtime /state/server /backups /keys && chown -R node:node /app /state /backups
USER node
EXPOSE 8787
ENTRYPOINT ["node", "/app/bootstrap/update-launcher.mjs"]
