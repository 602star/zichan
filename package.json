{
  "name": "zichan",
  "private": true,
  "version": "0.5.9",
  "description": "多资产生命周期记账系统 — local-first multi-asset lifecycle ledger",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node scripts/dev/runner.mjs start server",
    "start:web": "node scripts/dev/runner.mjs start web",
    "start:sync": "node scripts/dev/runner.mjs start sync",
    "start:server": "node scripts/dev/runner.mjs start server",
    "start:desktop": "node scripts/dev/runner.mjs start desktop",
    "mobile:init:android": "npm run android:init --workspace @zichan/desktop",
    "mobile:dev:android": "npm run android:dev --workspace @zichan/desktop",
    "mobile:build:android": "npm run android:build --workspace @zichan/desktop --",
    "mobile:init:ios": "npm run ios:init --workspace @zichan/desktop",
    "mobile:dev:ios": "npm run ios:dev --workspace @zichan/desktop",
    "mobile:build:ios": "npm run ios:build --workspace @zichan/desktop",
    "start:all": "node scripts/dev/runner.mjs start all",
    "stop": "node scripts/dev/runner.mjs stop all",
    "stop:web": "node scripts/dev/runner.mjs stop web",
    "stop:sync": "node scripts/dev/runner.mjs stop sync",
    "stop:server": "node scripts/dev/runner.mjs stop server",
    "stop:desktop": "node scripts/dev/runner.mjs stop desktop",
    "dev": "npm run dev --workspace @zichan/web",
    "server": "node scripts/dev/runner.mjs start server",
    "server:backup": "npm run backup --workspace @zichan/sync-server --",
    "server:verify-backup": "npm run verify-backup --workspace @zichan/sync-server --",
    "server:restore": "npm run restore --workspace @zichan/sync-server --",
    "quality:setup": "npm ci --prefix tools/eslint && npm ci --prefix tools/coverage && npm ci --prefix tools/e2e",
    "lint": "npm run lint --prefix tools/eslint",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test --prefix tools/coverage",
    "test:e2e": "npm run build:server && npm run test --prefix tools/e2e",
    "test:e2e:account": "npm run build:server && npm run test --prefix tools/e2e -- --config account.config.mjs",
    "test:release": "node --test tools/release/tests/check-consistency.test.mjs tools/release/tests/webview2-runtime.test.mjs tools/release/tests/create-windows-portable.test.mjs tools/release/tests/verify-artifacts.test.mjs tools/release/tests/update-feeds.test.mjs tools/release/tests/self-update-production.test.mjs tools/release/tests/update-launcher-integration.test.mjs",
    "bench:transactions": "npm run build && node packages/db/bench/transaction-scale.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @zichan/logger --workspace @zichan/core --workspace @zichan/db",
    "build:web": "npm run build --workspace @zichan/web",
    "release:check": "node scripts/release/check-consistency.mjs",
    "release:webview2:setup": "node scripts/release/setup-webview2-runtime.mjs",
    "release:webview2:check": "node scripts/release/setup-webview2-runtime.mjs --check",
    "release:portable": "node scripts/release/create-windows-portable.mjs",
    "ci": "npm run release:check && npm run test:scripts && npm run test:release && npm run build:server && npm run lint && npm run typecheck && npm run test:coverage",
    "start:server:built": "node scripts/dev/runner.mjs start server --no-build",
    "build:api": "npm run build && npm run build:app --workspace @zichan/sync-server",
    "build:server": "npm run build:api && npm run build:web",
    "build:desktop": "cmd /c scripts\\windows\\build-desktop.cmd",
    "build:desktop:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-installer.ps1",
    "build:desktop:linux": "bash scripts/linux/build-desktop.sh",
    "build:desktop:binary": "npm run build --workspace @zichan/desktop -- --no-bundle --ci",
    "test:scripts": "node --test tools/dev/tests/*.test.mjs",
    "server:prune-backups": "npm run prune-backups --workspace @zichan/sync-server --",
    "server:retire-node": "npm run retire-node --workspace @zichan/sync-server --",
    "server:retire-local-replica": "npm run retire-local-replica --workspace @zichan/sync-server --"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
