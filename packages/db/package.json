{
  "name": "@zichan/db",
  "version": "0.3.2",
  "description": "SQLite persistence: schema, migrations, and a LedgerStore over a driver port",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "development": "./src/node.ts",
      "node": "./dist/node.js",
      "default": "./src/node.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@serenity-kit/opaque": "^1.1.0",
    "@zichan/core": "*",
    "@zichan/logger": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
