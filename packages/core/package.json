{
  "name": "@zichan/core",
  "version": "0.5.6",
  "description": "Platform-agnostic core: data model + lifecycle calculations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "decimal.js": "^10.4.3",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
